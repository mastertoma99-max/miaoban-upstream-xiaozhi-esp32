{
    "manufacturer": "espressif",
    "type": "esp-vocat",
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp-vocat",
             "sdkconfig_append": [
                 "CONFIG_USE_EMOTE_MESSAGE_STYLE=y",
                 "CONFIG_MMAP_FILE_NAME_LENGTH=32",
                 "CONFIG_FLASH_EXPRESSION_ASSETS=y"
             ]
        },
        {
            "name": "esp-vocat-s3-n16r8",
            "sdkconfig_append": [
                "CONFIG_USE_EMOTE_MESSAGE_STYLE=y",
                "CONFIG_MMAP_FILE_NAME_LENGTH=32",
                "CONFIG_FLASH_EXPRESSION_ASSETS=y",
                "CONFIG_USE_DEVICE_AEC=y"
            ]
        },
        {
            "name": "esp-vocat-s3-n16r8-thread",
            "sdkconfig_append": [
                "CONFIG_USE_EMOTE_MESSAGE_STYLE=y",
                "CONFIG_MMAP_FILE_NAME_LENGTH=32",
                "CONFIG_FLASH_EXPRESSION_ASSETS=y",
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_MIAOBAN_THREAD_BR=y",
                "CONFIG_MIAOBAN_THREAD_TX_GPIO=8",
                "CONFIG_MIAOBAN_THREAD_RX_GPIO=21",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_thread.csv\"",
                "CONFIG_OPENTHREAD_ENABLED=y",
                "CONFIG_OPENTHREAD_RADIO_SPINEL_UART=y",
                "CONFIG_OPENTHREAD_FTD=y",
                "CONFIG_OPENTHREAD_PLATFORM_NETIF=y",
                "CONFIG_OPENTHREAD_BORDER_ROUTER=y",
                "CONFIG_OPENTHREAD_TASK_SIZE=8192",
                "CONFIG_OPENTHREAD_CONSOLE_ENABLE=n",
                "CONFIG_OPENTHREAD_CLI=n",
                "CONFIG_OPENTHREAD_PLATFORM_MALLOC_CAP_SPIRAM=y",
                "CONFIG_OPENTHREAD_PLATFORM_MSGPOOL_MANAGEMENT=y",
                "CONFIG_OPENTHREAD_NUM_MESSAGE_BUFFERS=1024",
                "CONFIG_LWIP_IPV6_FORWARD=y",
                "CONFIG_LWIP_IPV6_NUM_ADDRESSES=12",
                "CONFIG_LWIP_MULTICAST_PING=y",
                "CONFIG_LWIP_NETIF_STATUS_CALLBACK=y",
                "CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y",
                "CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y",
                "CONFIG_LWIP_HOOK_IP6_INPUT_CUSTOM=y",
                "CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y",
                "CONFIG_LWIP_IPV6_AUTOCONFIG=y",
                "CONFIG_MDNS_MULTIPLE_INSTANCE=y",
                "CONFIG_MBEDTLS_SSL_PROTO_DTLS=y",
                "CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y",
                "CONFIG_MBEDTLS_ECJPAKE_C=y"
            ]
        }
    ]
}
